<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:text="SPACE COLONY" android:textSize="28sp" android:textStyle="bold" android:layout_gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Button android:text="Create Crew Member" android:id="@+id/btnCreate" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:text="View Quarters" android:id="@+id/btnQuarters" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:text="Simulator Training" android:id="@+id/btnSimulator" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:text="Mission Control" android:id="@+id/btnMission" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
